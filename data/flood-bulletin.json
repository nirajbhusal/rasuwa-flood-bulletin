  "advisory": [
    {
      "id": "green",
      "level": {
        "ne": "सामान्य अवस्था",
        "en": "Normal"
      },
      "public": {
        "ne": "नदीको बहाव सामान्य अवस्थामा छ। बाढीको जोखिम न्यून छ। नियमित रूपमा सूचना प्राप्त गरिरहनुहोस्।",
        "en": "The river is at a normal flow. Flood risk is low. Keep checking updates."
      },
      "agency": {
        "ne": "नियमित अनुगमन तथा तयारीको अवस्था कायम राख्ने। कुनै विशेष कार्य आवश्यक छैन।",
        "en": "Keep routine monitoring and preparedness. No special action is needed."
      }
    },
    {
      "id": "yellow",
      "level": {
        "ne": "सतर्क रहनुहोस्",
        "en": "Stay alert"
      },
      "public": {
        "ne": "नदीको जलसतह बढ्न सक्ने तथा चेतावनी तह नजिक पुग्न सक्ने सम्भावना छ। नदी तटीय तथा होचा भू-भागका बासिन्दाले सतर्क रही अद्यावधिक सूचना प्राप्त गरिरहनुहोस्।",
        "en": "The river may rise and approach the warning level. People in riverside and low-lying areas should stay alert and follow updates."
      },
      "agency": {
        "ne": "नदीको अवस्थाको निगरानी बढाउने, स्थानीय तह तथा समुदायलाई सूचित गर्ने र आवश्यक तयारी सुरु गर्ने।",
        "en": "Watch the river more closely, inform the local level and community, and start the needed preparation."
      }
    },
    {
      "id": "orange",
      "level": {
        "ne": "तयारी अवस्थामा रहनुहोस्",
        "en": "Be prepared"
      },
      "public": {
        "ne": "नदी तटीय तथा जोखिमयुक्त क्षेत्रमा बाढी आउने सम्भावना उच्च छ। अत्यावश्यक सामग्री तयारी अवस्थामा राख्नुहोस् र आवश्यक परे सुरक्षित स्थानमा जान तयार रहनुहोस्।",
        "en": "Flooding is highly possible in riverside and at-risk areas. Keep essential supplies ready and be prepared to move to safety if needed."
      },
      "agency": {
        "ne": "आपतकालीन तयारीका उपायहरू कार्यान्वयन गर्ने, उद्धार तथा राहतका स्रोत-साधन तयारी अवस्थामा राख्ने र सम्भावित स्थानान्तरणको तयारी गर्ने।",
        "en": "Put emergency preparations in place, keep rescue and relief resources ready, and prepare for a possible move."
      }
    },
    {
      "id": "red",
      "level": {
        "ne": "तुरुन्त प्रतिकार्य गर्नुहोस्",
        "en": "Respond now"
      },
      "public": {
        "ne": "गम्भीर बाढीको जोखिम रहेको वा बाढी भइरहेको अवस्था हो। सम्बन्धित निकायको निर्देशन अनुसार सुरक्षित स्थानमा जानुहोस् तथा नदी र बाढीग्रस्त क्षेत्रबाट टाढा रहनुहोस्।",
        "en": "There is a serious flood risk, or a flood is underway. Follow the instruction of the responsible office, go to a safe place, and stay away from the river and flooded areas."
      },
      "agency": {
        "ne": "उद्धार, राहत तथा आवश्यक परे स्थानान्तरणका कार्यहरू तत्काल सञ्चालन गर्ने तथा बहु-निकाय समन्वय गरी आपतकालीन प्रतिकार्य सुरु गर्ने।",
        "en": "Start rescue, relief, and, if needed, relocation at once, and begin the emergency response with coordination across offices."
      }
    }
  ],
